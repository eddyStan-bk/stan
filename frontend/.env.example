# Copier en .env (jamais versionné) pour un build local.

# URL de l'application PHP exposant api/public/*.php (sans barre finale).
# OSME_API_URL=https://osm.erspdrc.com

# 1 : le build échoue si l'API ne répond pas (recommandé avant un déploiement).
# OSME_API_REQUIRED=1

# 1 : données fictives + bandeau « démonstration ». Ne jamais déployer en production.
# OSME_DEMO_DATA=1
